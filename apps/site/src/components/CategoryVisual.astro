---
import type { CategoryId } from '@niftyfix/tool-sdk';
import CheckRows from './previews/CheckRows.astro';
import PagesPreview from './previews/PagesPreview.astro';
import SizePreview from './previews/SizePreview.astro';
import Window from './previews/Window.astro';

/** A category's own picture: a real screen from one of its tools. Categories without live tools get none. */
export interface Props {
  category: CategoryId;
}
const { category } = Astro.props;
---

{category === 'forms' ? (
  <Window title="Signature Resizer — signature.jpg">
    <div class="grid grid-cols-[7rem_1fr] gap-4 p-4">
      <div class="flex aspect-[3/1] items-center justify-center self-start rounded-md bg-white ring-2 ring-brand-600 dark:ring-brand-400">
        <svg
          viewBox="0 0 120 40"
          class="w-5/6 text-stone-900"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
        >
          <path d="M6 28c8-2 10-18 18-18s-2 20 6 20 8-12 14-12 2 10 8 10 10-14 16-14 4 8 10 8 12-4 16-6" />
        </svg>
      </div>
      <div data-run="checks">
        <CheckRows
          compact
          rows={[
            { label: 'Dimensions', required: '140 × 60 px', actual: '140 × 60 px', status: 'pass' },
            { label: 'File size', required: '10–20 KB', actual: '14.2 KB', status: 'pass' },
            { label: 'Format', required: 'JPEG', actual: 'JPEG', status: 'pass' },
          ]}
        />
      </div>
    </div>
  </Window>
) : category === 'pdf' ? (
  <div class="relative">
    <Window title="Organize PDF — 4 pages">
      <PagesPreview />
    </Window>
    <Window title="Compress PDF" class="relative z-10 -mt-8 ml-auto w-3/5">
      <SizePreview
        before="4.8 MB"
        after="196 KB"
        target="200 KB"
        meter="w-[98%]"
        fromKb={4800}
        toKb={196}
      />
    </Window>
  </div>
) : null}
