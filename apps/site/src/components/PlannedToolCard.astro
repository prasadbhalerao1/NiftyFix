---
import type { PlannedTool } from '@niftyfix/registry';

export interface Props {
  tool: PlannedTool;
}
const { tool } = Astro.props;
---

<!-- Not a link: a planned tool has no page until it works. -->
<div
  class="border-b border-dashed border-stone-300 py-2.5 dark:border-stone-800"
  data-tool-card
  data-planned
  data-terms={`${tool.name} ${tool.slug.replaceAll('-', ' ')}`.toLowerCase()}
>
  <span class="text-stone-800 dark:text-stone-300">{tool.name}</span>
</div>
