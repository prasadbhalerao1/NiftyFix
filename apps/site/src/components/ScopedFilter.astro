---
/**
 * Filters the tools inside the nearest [data-filter-scope]: rows with
 * data-tool-card are matched on data-terms; sections ([data-filter-group])
 * left empty are hidden. Hidden without JavaScript, where it could not work.
 */
export interface Props {
  id: string;
  label: string;
  placeholder: string;
}
const { id, label, placeholder } = Astro.props;
---

<div class="relative max-w-md" hidden data-scoped-filter>
  <label for={id} class="sr-only">
    {label}
  </label>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-stone-500 dark:text-stone-400"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <input
    id={id}
    type="search"
    autocomplete="off"
    placeholder={placeholder}
    class="search-input min-h-11 pl-10 text-sm"
  />
  <p class="mt-3 hidden text-sm text-stone-700 dark:text-stone-400" role="status" data-filter-empty>
    Nothing here matches. Try the search at the top of the page to look across every category.
  </p>
</div>

<script>
  for (const wrapper of document.querySelectorAll<HTMLElement>('[data-scoped-filter]')) {
    const scope = wrapper.closest<HTMLElement>('[data-filter-scope]');
    const input = wrapper.querySelector<HTMLInputElement>('input');
    const empty = wrapper.querySelector<HTMLElement>('[data-filter-empty]');
    if (!scope || !input) continue;
    wrapper.hidden = false;
    const cards = [...scope.querySelectorAll<HTMLElement>('[data-tool-card]')];
    const groups = [...scope.querySelectorAll<HTMLElement>('[data-filter-group]')];
    input.addEventListener('input', () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const match = words.every((word) => (card.dataset.terms ?? '').includes(word));
        (card.closest('li') ?? card).hidden = !match;
        if (match) shown += 1;
      }
      for (const group of groups) {
        group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-tool-card]')].some(
          (card) => !(card.closest('li') ?? card).hidden,
        );
      }
      empty?.classList.toggle('hidden', shown > 0);
    });
  }
</script>
