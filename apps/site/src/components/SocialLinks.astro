---
import { OPERATOR } from '../data/site';

/** The maker's GitHub and LinkedIn, as small icon links (simple-icons paths, CC0). */
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const LINKS = [
  {
    label: 'GitHub',
    href: OPERATOR.github,
    path: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3',
  },
  {
    label: 'LinkedIn',
    href: OPERATOR.linkedin,
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
] as const;
---

<ul class:list={['flex list-none flex-row items-center gap-2 pl-0', className]} role="list">
  {LINKS.map(({ label, href, path }) => (
    <li>
      <a
        href={href}
        rel="me noopener"
        target="_blank"
        aria-label={`${OPERATOR.name} on ${label}`}
        class="press flex size-9 items-center justify-center rounded-lg border border-stone-300 text-stone-700 transition-colors hover:border-brand-600 hover:text-brand-800 dark:border-stone-700 dark:text-stone-300 dark:hover:border-brand-400 dark:hover:text-brand-300"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="currentColor">
          <path d={path} />
        </svg>
      </a>
    </li>
  ))}
</ul>
