---
import { toolPath } from '@niftyfix/registry';
import type { ToolManifest } from '@niftyfix/tool-sdk';

export interface Props {
  manifest: ToolManifest;
}
const { manifest } = Astro.props;
---

<a
  href={toolPath(manifest)}
  class="group flex h-full flex-col gap-1 rounded-[var(--radius-panel)] border border-stone-200 bg-white p-4 transition-colors hover:border-teal-600 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-teal-400"
  data-tool-card
  data-terms={[manifest.name, ...manifest.searchAliases].join(' ').toLowerCase()}
>
  <span class="font-semibold group-hover:text-teal-800 dark:group-hover:text-teal-300">
    {manifest.name}
  </span>
  <span class="text-sm text-stone-600 dark:text-stone-400">{manifest.tagline}</span>
</a>
