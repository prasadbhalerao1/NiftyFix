---
import { toolPath } from '@niftyfix/registry';
import type { ToolManifest } from '@niftyfix/tool-sdk';
import { toolIcon } from '../data/icons';

/** A tool as a list row: icon tile, name, one-line tagline, arrow. Searchable by data-terms. */
export interface Props {
  manifest: ToolManifest;
  /** Hide the tagline in dense lists. */
  dense?: boolean;
}
const { manifest, dense = false } = Astro.props;
---

<a
  href={toolPath(manifest)}
  class:list={[
    'group flex items-center gap-4 rounded-xl border border-transparent transition-colors hover:border-stone-200 hover:bg-paper dark:hover:border-stone-800 dark:hover:bg-stone-900/70',
    dense ? 'p-2' : 'p-3',
  ]}
  data-tool-card
  data-terms={[manifest.name, manifest.tagline, ...manifest.searchAliases].join(' ').toLowerCase()}
>
  <span
    class:list={[
      'flex shrink-0 items-center justify-center rounded-lg border border-stone-200 bg-paper text-stone-800 transition-colors group-hover:border-brand-600/50 group-hover:text-brand-800 dark:border-stone-800 dark:bg-stone-900 dark:text-stone-200 dark:group-hover:border-brand-400/50 dark:group-hover:text-brand-300',
      dense ? 'size-8' : 'size-10',
    ]}
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class={dense ? 'size-4' : 'size-5'}
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={toolIcon(manifest.id)}></path>
    </svg>
  </span>
  <span class="flex min-w-0 flex-1 flex-col">
    <span class="font-medium">{manifest.name}</span>
    {dense ? null : (
      <span class="line-clamp-1 text-sm text-stone-700 dark:text-stone-400">
        {manifest.tagline}
      </span>
    )}
  </span>
  <span
    aria-hidden="true"
    class="text-stone-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700 dark:text-stone-600 dark:group-hover:text-brand-400"
  >
    →
  </span>
</a>
