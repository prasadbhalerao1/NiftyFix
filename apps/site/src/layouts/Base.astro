---
import '../styles/global.css';
import SearchPalette from '../components/SearchPalette.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { absoluteUrl, SITE_NAME } from '../data/registry';

export interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/forms/photo-resizer/". Used for the canonical URL. */
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const canonical = absoluteUrl(path);
---

<!doctype html>
<html lang="en" class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0c0a09" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:rounded focus:bg-paper focus:px-3 focus:py-2 focus:text-stone-900"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 pt-8">
      <slot />
    </main>
    <SiteFooter />
    <SearchPalette />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
