---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | NiftyFix"
  description="This page does not exist."
  path="/404/"
  noindex
>
  <h1 class="text-2xl font-bold">Page not found</h1>
  <p class="mt-2 text-stone-700 dark:text-stone-300">This page does not exist or has moved.</p>
  <p class="mt-6">
    <a href="/" class="font-medium text-teal-800 underline underline-offset-4 dark:text-teal-300">
      Find a tool on the home page
    </a>
  </p>
</Base>
