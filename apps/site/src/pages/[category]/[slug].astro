---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import ToolFrame from '../../components/ToolFrame.astro';
import { absoluteUrl, registry, SITE_NAME } from '../../data/registry';
import { categoryPath, toolPath, variantPath, type ToolEntry } from '@niftyfix/registry';
import { CATEGORIES, FILE_FORMATS, type ToolVariant } from '@niftyfix/tool-sdk';

/** One page per tool, plus one per search intent of a live tool ("compress PDF to 200 KB"). */
export function getStaticPaths() {
  return [
    ...registry.tools.map((entry) => ({
      params: { category: entry.manifest.category, slug: entry.manifest.slug },
      props: { entry, variant: undefined },
    })),
    ...registry.variantPages().map(({ entry, variant }) => ({
      params: { category: entry.manifest.category, slug: variant.slug },
      props: { entry, variant },
    })),
  ];
}

interface Props {
  entry: ToolEntry;
  variant: ToolVariant | undefined;
}

const { entry, variant } = Astro.props;
const { manifest, content } = entry;
const category = CATEGORIES[manifest.category];
const path = variant ? variantPath(manifest, variant) : toolPath(manifest);
const page = variant ?? manifest;
const faqs = [...(variant?.faqs ?? []), ...content.faqs];
// Every intent page links to the tool and its siblings, so each is reachable and gets context.
const intents = (manifest.status === 'live' ? (content.variants ?? []) : []).filter(
  (other) => other.slug !== variant?.slug,
);
const related = registry.related(manifest.id);
const inputs = manifest.input.formats.map((id) => FILE_FORMATS[id].label).join(', ');
const outputs = manifest.output.formats.map((id) => FILE_FORMATS[id].label).join(', ');
const mb = (bytes: number) => `${Math.round(bytes / 1_000_000)} MB`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: category.name, path: categoryPath(manifest.category) },
  { name: manifest.name, path: toolPath(manifest) },
  ...(variant ? [{ name: variant.label, path }] : []),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: absoluteUrl(crumb.path),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: variant ? variant.h1 : manifest.name,
    url: absoluteUrl(path),
    description: page.seoDescription,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: SITE_NAME },
  },
];
---

<Base
  title={page.seoTitle}
  description={page.seoDescription}
  path={path}
  noindex={manifest.status !== 'live'}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{page.h1}</h1>
  <p class="mt-2 max-w-[72ch] text-stone-700 dark:text-stone-300">
    {variant ? variant.intro : manifest.tagline}
  </p>
  <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-sm text-brand-900 dark:bg-brand-950 dark:text-brand-100">
    <span aria-hidden="true">●</span> Runs on your device — your file is not uploaded
  </p>

  <div class="mt-6">
    <ToolFrame toolId={manifest.id} title={`${manifest.name} tool`} preset={variant?.preset} />
  </div>

  {intents.length > 0 ? (
    <nav aria-labelledby="intents-heading" class="mt-4">
      <h2 id="intents-heading" class="text-sm font-medium text-stone-600 dark:text-stone-400">
        {variant ? `Other ${manifest.name} pages` : 'Popular settings'}
      </h2>
      <ul class="mt-2 flex flex-wrap gap-2">
        {variant ? (
          <li>
            <a
              href={toolPath(manifest)}
              class="inline-block rounded-full border border-stone-300 px-3 py-1 text-sm hover:border-brand-600 hover:text-brand-800 dark:border-stone-700 dark:hover:border-brand-400 dark:hover:text-brand-300"
            >
              {manifest.name}
            </a>
          </li>
        ) : null}
        {intents.map((other) => (
          <li>
            <a
              href={variantPath(manifest, other)}
              class="inline-block rounded-full border border-stone-300 px-3 py-1 text-sm hover:border-brand-600 hover:text-brand-800 dark:border-stone-700 dark:hover:border-brand-400 dark:hover:text-brand-300"
            >
              {other.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : null}

  <dl class="mt-6 grid gap-3 rounded-[var(--radius-panel)] border border-stone-200 bg-white p-4 text-sm sm:grid-cols-3 dark:border-stone-800 dark:bg-stone-900">
    <div>
      <dt class="text-stone-600 dark:text-stone-400">Accepts</dt>
      <dd class="font-medium">{inputs}</dd>
    </div>
    <div>
      <dt class="text-stone-600 dark:text-stone-400">Produces</dt>
      <dd class="font-medium">{outputs}</dd>
    </div>
    <div>
      <dt class="text-stone-600 dark:text-stone-400">Maximum file size</dt>
      <dd class="font-medium">
        {mb(manifest.input.maxBytes.desktop)} on computers · {mb(manifest.input.maxBytes.mobile)} on
        phones
      </dd>
    </div>
  </dl>

  <article class="prose-nf mt-4">
    <p>{content.intro}</p>

    <h2>How to use it</h2>
    <ol>
      {content.howTo.map((step) => (
        <li>{step}</li>
      ))}
    </ol>

    <h2>Options explained</h2>
    {content.options.map((option) => (
      <>
        <h3>{option.name}</h3>
        <p>{option.description}</p>
      </>
    ))}

    {content.example ? (
      <>
        <h2>{content.example.title}</h2>
        <ul>
          <li>
            <strong>Input:</strong> {content.example.input}
          </li>
          <li>
            <strong>Settings:</strong> {content.example.settings}
          </li>
          <li>
            <strong>Result:</strong> {content.example.output}
          </li>
        </ul>
      </>
    ) : null}

    <h2>Limits and troubleshooting</h2>
    <ul>
      {content.limits.map((limit) => (
        <li>{limit}</li>
      ))}
    </ul>

    <h2>Questions</h2>
    {faqs.map((faq) => (
      <>
        <h3>{faq.question}</h3>
        <p>{faq.answer}</p>
      </>
    ))}
  </article>

  {related.length > 0 ? (
    <section class="mt-10">
      <h2 class="mb-3 text-xl font-semibold">Related tools</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((tool) => (
          <ToolCard manifest={tool.manifest} />
        ))}
      </div>
    </section>
  ) : null}
</Base>
