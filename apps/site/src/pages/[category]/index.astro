---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogueGrid from '../../components/CatalogueGrid.astro';
import { registry, SITE_NAME } from '../../data/registry';
import { categoryPath } from '@niftyfix/registry';
import { CATEGORIES, CATEGORY_IDS, type CategoryId } from '@niftyfix/tool-sdk';

/** Every category has a hub, listing its built tools and its planned ones. */
export function getStaticPaths() {
  return CATEGORY_IDS.map((category) => ({ params: { category }, props: { category } }));
}

interface Props {
  category: CategoryId;
}

const { category } = Astro.props;
const info = CATEGORIES[category];
const items = registry.catalogue(category);
const path = categoryPath(category);
const ready = items.filter((item) => item.kind === 'built').length;
// Indexed only once it links to at least one finished (live) tool.
const indexable = items.some(
  (item) => item.kind === 'built' && item.entry.manifest.status === 'live',
);
---

<Base
  title={`${info.h1} | ${SITE_NAME}`}
  description={info.description}
  path={path}
  noindex={!indexable}
>
  <Breadcrumbs
    items={[
      { name: 'Home', path: '/' },
      { name: info.name, path },
    ]}
  />
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{info.h1}</h1>
  <p class="mt-2 max-w-[72ch] text-stone-700 dark:text-stone-300">{info.description}</p>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
    {ready > 0 ? `${ready} ready to use · ` : ''}
    {items.length - ready} coming soon
  </p>
  <div class="mt-6">
    <CatalogueGrid items={items} />
  </div>
</Base>
