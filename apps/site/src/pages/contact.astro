import Prose from '../layouts/Prose.astro';
---

<Prose title="Contact" description="How to contact the NiftyFix team." path="/contact/" noindex>
  <p>
    A support email address and response-time commitment will be published here before public
    launch. Until then, this site is a preview.
  </p>
  <h2>Reporting a problem with a tool</h2>
  <p>
    Please include the tool name, your browser and device, the file type, and the error message
    shown. Do not send us the file itself unless we ask, and never send documents containing
    personal information.
  </p>
</Prose>
