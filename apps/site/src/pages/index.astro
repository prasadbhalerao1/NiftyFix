---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import ToolRow from '../components/ToolRow.astro';
import CheckRows from '../components/previews/CheckRows.astro';
import PagesPreview from '../components/previews/PagesPreview.astro';
import PortraitArt from '../components/previews/PortraitArt.astro';
import SizePreview from '../components/previews/SizePreview.astro';
import Window from '../components/previews/Window.astro';
import { absoluteUrl, registry, SITE_NAME } from '../data/registry';
import { categoryPath, toolPath, variantPath, type CatalogueItem } from '@niftyfix/registry';
import { CATEGORIES, CATEGORY_IDS, type ToolManifest } from '@niftyfix/tool-sdk';

const liveCount = registry.indexable().length;
const tool = (id: string): ToolManifest[] => {
  const entry = registry.byId(id);
  return entry ? [entry.manifest] : [];
};
const built = (items: readonly CatalogueItem[]) =>
  items.flatMap((item) => (item.kind === 'built' ? [item.entry.manifest] : []));

const intents = registry.variantPages().map(({ entry, variant }) => ({
  href: variantPath(entry.manifest, variant),
  label: variant.label,
  h1: variant.h1,
  tool: entry.manifest,
}));
const heroIntents = [
  'resize-photo-to-20kb',
  'signature-resize-10-to-20kb',
  'compress-pdf-to-200kb',
  'resize-pdf-to-a4',
].flatMap((slug) => intents.filter(({ href }) => href.endsWith(`/${slug}/`)));

const formsTools = built(registry.catalogue('forms'));
const pdfTools = built(registry.catalogue('pdf'));
const formIntents = intents.filter(({ tool }) => tool.category === 'forms');
const comingCategories = CATEGORY_IDS.filter((id) => !registry.activeCategories().includes(id)).map(
  (id) => {
    const items = registry.catalogue(id);
    return {
      id,
      count: items.length,
      examples: items
        .flatMap((item) => (item.kind === 'planned' ? [item.tool.name] : []))
        .slice(0, 3),
    };
  },
);

const essentials = [
  'forms.photo-resizer',
  'pdf.compress-pdf',
  'pdf.merge-pdf',
  'forms.signature-resizer',
  'pdf.sign-pdf',
  'pdf.organize-pdf',
  'pdf.pdf-to-image',
  'pdf.image-to-pdf',
].flatMap(tool);

const photoChecks = [
  { label: 'Dimensions', required: '200 × 230 px', actual: '200 × 230 px', status: 'pass' },
  { label: 'File size', required: '20–50 KB', actual: '38.4 KB', status: 'pass' },
  { label: 'Format', required: 'JPEG', actual: 'JPEG', status: 'pass' },
  { label: 'File extension', required: '.jpg', actual: '.jpg', status: 'pass' },
  { label: 'Resolution (DPI)', required: 'Not set', actual: '—', status: 'not-checked' },
] as const;

const pdfFlow = ['pdf.merge-pdf', 'pdf.organize-pdf', 'pdf.compress-pdf', 'pdf.sign-pdf'].flatMap(
  tool,
);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/') },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: absoluteUrl('/'),
    logo: absoluteUrl('/icon-512.png'),
  },
];
---

<Base
  title="NiftyFix — get your files ready for any upload"
  description="Free tools that prepare photos, signatures, documents and media to meet exact upload requirements, then verify the result. Files are processed on your device."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero: search on the left, real tool screens on the right. -->
  <section class="relative isolate grid items-center gap-12 pt-6 pb-20 lg:grid-cols-[1.05fr_1fr] lg:pt-14 lg:pb-40">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="rise relative z-10">
      <p class="eyebrow flex items-center gap-2">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        <span data-count-up>{liveCount}</span> tools live · runs on your device
      </p>
      <h1 class="display mt-5 text-[2.6rem] leading-[1.02] sm:text-6xl lg:text-[4.25rem]">
        Get your files ready for <span class="accent">any</span> upload.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-pretty text-stone-700 dark:text-stone-300">
        The exact photo, signature or PDF a form asks for — right size, right dimensions, right
        format — checked before you download. Nothing is uploaded.
      </p>
      <div class="mt-8 max-w-xl">
        <SearchBox id="tool-search" label="What do you need to do?" readQuery />
      </div>
      <nav aria-label="Popular" class="mt-5 flex max-w-xl flex-wrap items-center gap-2 text-sm">
        <span class="eyebrow mr-1">Try</span>
        {heroIntents.map(({ href, h1 }) => (
          <a
            href={href}
            class="rounded-full border border-stone-300 px-3 py-1.5 text-stone-700 transition-colors hover:border-brand-600 hover:text-brand-800 dark:border-stone-700 dark:text-stone-300 dark:hover:border-brand-400 dark:hover:text-brand-300"
          >
            {h1}
          </a>
        ))}
      </nav>
    </div>

    <!--
      Layered composition of real screens: the photo check, a PDF target, the page grid.
      It plays as a short demo when it comes into view (src/scripts/motion.ts) and tilts
      with the pointer; the Replay button runs it again.
    -->
    <div class="rise relative mx-auto w-full max-w-[34rem] lg:mx-0" data-demo>
      <button type="button" class="replay-button" data-demo-replay hidden>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5"></path>
        </svg>
        Replay demo
      </button>
      <div class="demo-stage" aria-hidden="true" data-tilt>
        <Window title="Form Photo Resizer — photo.jpg" class="depth-2 relative z-10">
          <div class="grid gap-4 p-4 sm:grid-cols-[8rem_1fr]">
            <div class="hidden sm:block">
              <div class="overflow-hidden rounded-md ring-2 ring-brand-600 dark:ring-brand-400">
                <PortraitArt class="w-full" />
              </div>
              <p class="mt-2 text-center font-mono text-[10px] text-stone-600 dark:text-stone-400">
                3.1 MB → 38.4 KB
              </p>
            </div>
            <div data-run="checks">
              <CheckRows rows={photoChecks.slice(0, 4)} compact />
            </div>
          </div>
          <div class="flex items-center justify-between gap-3 border-t border-stone-200 px-4 py-3 dark:border-stone-800">
            <span class="verdict flex items-center gap-2 text-sm font-medium text-emerald-800 dark:text-emerald-400">
              <svg
                viewBox="0 0 16 16"
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 8.5 6.5 12 13 4.5"></path>
              </svg>
              Meets every requirement
            </span>
            <span class="demo-download rounded-lg bg-brand-700 px-3 py-1.5 text-sm font-medium text-white">
              Download
            </span>
          </div>
        </Window>
        <Window
          title="Compress PDF"
          class="depth-3 relative z-20 -mt-4 ml-auto w-[70%] sm:w-[62%] lg:absolute lg:-right-8 lg:-bottom-32 lg:mt-0 lg:w-[52%]"
        >
          <SizePreview
            before="4.8 MB"
            after="196 KB"
            target="200 KB"
            meter="w-[98%]"
            fromKb={4800}
            toKb={196}
          />
        </Window>
        <Window
          title="Organize PDF — 4 pages"
          class="depth-1 absolute -bottom-40 -left-10 hidden w-[52%] lg:block"
        >
          <PagesPreview />
        </Window>
      </div>
    </div>
  </section>

  <!-- Categories: what is live is large; what is coming is a dense index. -->
  <section data-reveal aria-labelledby="workshops-heading">
    <p class="eyebrow">Categories</p>
    <h2 id="workshops-heading" class="section-title mt-3">
      {registry.activeCategories().length} categories open today.{' '}
      <span class="quiet">{comingCategories.length} more on the roadmap.</span>
    </h2>

    <div class="mt-10 grid gap-4 lg:grid-cols-12" data-stagger>
      <article class="panel spotlight flex flex-col overflow-hidden lg:col-span-7">
        <div class="flex flex-col gap-6 p-6 sm:flex-row sm:p-8">
          <div class="flex-1">
            <p class="eyebrow text-brand-800 dark:text-brand-400">Form-ready</p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight">
              <a href={categoryPath('forms')} class="hover:underline">
                Photos and signatures that pass the upload
              </a>
            </h3>
            <p class="mt-3 text-stone-700 dark:text-stone-400">{CATEGORIES.forms.description}</p>
          </div>
          <div class="flex shrink-0 gap-3 sm:w-44 sm:flex-col" aria-hidden="true">
            <div class="flex items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 font-mono text-xs dark:border-stone-800">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>200 × 230 px
            </div>
            <div class="flex items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 font-mono text-xs dark:border-stone-800">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>20–50 KB
            </div>
            <div class="flex items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 font-mono text-xs dark:border-stone-800">
              <span class="size-1.5 rounded-full bg-emerald-500"></span>JPEG
            </div>
          </div>
        </div>
        <ul
          class="grid border-t border-stone-200 p-2 sm:grid-cols-2 dark:border-stone-800"
          role="list"
        >
          {formsTools.map((manifest) => (
            <li>
              <ToolRow manifest={manifest} />
            </li>
          ))}
        </ul>
        <div class="mt-auto flex flex-wrap gap-2 border-t border-stone-200 px-6 py-4 dark:border-stone-800">
          {formIntents.map(({ href, h1 }) => (
            <a
              href={href}
              class="rounded-md bg-stone-100 px-2.5 py-1 font-mono text-xs text-stone-800 transition-colors hover:bg-brand-100 hover:text-brand-900 dark:bg-stone-800 dark:text-stone-300 dark:hover:bg-brand-500/15 dark:hover:text-brand-300"
            >
              {h1}
            </a>
          ))}
        </div>
      </article>

      <article class="panel spotlight flex flex-col overflow-hidden lg:col-span-5">
        <div class="p-6 sm:p-8">
          <p class="eyebrow text-brand-800 dark:text-brand-400">PDF · {pdfTools.length} tools</p>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight">
            <a href={categoryPath('pdf')} class="hover:underline">
              The whole PDF desk
            </a>
          </h3>
          <p class="mt-3 text-stone-700 dark:text-stone-400">{CATEGORIES.pdf.description}</p>
        </div>
        <ul
          class="grid grid-cols-2 gap-x-2 border-t border-stone-200 px-4 py-3 text-sm dark:border-stone-800"
          role="list"
        >
          {pdfTools.map((manifest) => (
            <li>
              <a
                href={toolPath(manifest)}
                class="block truncate rounded-md px-2 py-1.5 text-stone-800 transition-colors hover:bg-stone-100 hover:text-brand-800 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-brand-300"
              >
                {manifest.name}
              </a>
            </li>
          ))}
        </ul>
      </article>

      <article class="panel spotlight p-6 sm:p-8 lg:col-span-12">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-lg font-semibold tracking-tight">Coming next</h3>
          <a
            href="/tools/"
            class="text-sm font-medium text-brand-800 hover:underline dark:text-brand-300"
          >
            See the full catalogue →
          </a>
        </div>
        <ul
          class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4"
          role="list"
          data-stagger
        >
          {comingCategories.map(({ id, count, examples }) => (
            <li>
              <a href={categoryPath(id)} class="group block">
                <span class="flex items-baseline justify-between gap-2 border-b border-stone-200 pb-2 dark:border-stone-800">
                  <span class="font-medium group-hover:text-brand-800 dark:group-hover:text-brand-300">
                    {CATEGORIES[id].name}
                  </span>
                  <span class="font-mono text-xs text-stone-600 dark:text-stone-400">{count}</span>
                </span>
                <span class="mt-2 block text-sm text-stone-700 dark:text-stone-400">
                  {examples.join(' · ')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <!-- Essentials: a calm two-column list, like a launcher. -->
  <section data-reveal aria-labelledby="essentials-heading" class="mt-28">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_2fr]">
      <div>
        <p class="eyebrow">Start here</p>
        <h2 id="essentials-heading" class="section-title mt-3">
          The tools forms ask for.{' '}
          <span class="quiet">
            One click away, or <kbd class="keycap align-middle">Ctrl K</kbd> from anywhere.
          </span>
        </h2>
      </div>
      <ul class="grid gap-1 sm:grid-cols-2" role="list" data-stagger>
        {essentials.map((manifest) => (
          <li>
            <ToolRow manifest={manifest} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Upload-ready: the validation report is the product. -->
  <section data-reveal aria-labelledby="ready-heading" class="mt-28">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Upload-ready</p>
        <h2 id="ready-heading" class="section-title mt-3">
          Proof, not promises.{' '}
          <span class="quiet">
            Every file is checked against your requirement before you download it.
          </span>
        </h2>
        <ul class="mt-8 flex flex-col gap-4 text-stone-700 dark:text-stone-300" role="list">
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-600"></span>
            Set the exact pixel size, the KB range and the format the portal publishes.
          </li>
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-600"></span>
            The result is measured from the file itself, not from the settings you chose.
          </li>
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand-600"></span>
            Anything that was not checked says so plainly, so you know what to look at yourself.
          </li>
        </ul>
        <a
          href={categoryPath('forms')}
          class="press mt-8 inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-5 font-medium text-white transition-colors hover:bg-brand-800"
        >
          Prepare a photo or signature
        </a>
      </div>
      <div class="relative" aria-hidden="true" data-demo>
        <Window title="Result — validation report" class="spotlight">
          <div class="grid grid-cols-2 gap-px border-b border-stone-200 bg-stone-200 dark:border-stone-800 dark:bg-stone-800">
            <div class="bg-paper p-4 dark:bg-stone-900">
              <p class="eyebrow">Original</p>
              <p class="mt-1 font-mono text-sm">3024 × 4032 · 3.1 MB</p>
            </div>
            <div class="bg-paper p-4 dark:bg-stone-900">
              <p class="eyebrow">Output</p>
              <p class="mt-1 font-mono text-sm text-brand-800 dark:text-brand-300">
                200 × 230 · 38.4 KB
              </p>
            </div>
          </div>
          <div class="px-4 pb-2" data-run="checks">
            <CheckRows rows={photoChecks} />
          </div>
        </Window>
      </div>
    </div>
  </section>

  <!-- Workflows: a whole task, step by step. -->
  <section data-reveal aria-labelledby="flow-heading" class="mt-28">
    <p class="eyebrow">Workflows</p>
    <h2 id="flow-heading" class="section-title mt-3">
      Finish the whole task.{' '}
      <span class="quiet">Download from one tool and drop it into the next.</span>
    </h2>
    <ol class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {pdfFlow.map((manifest, index) => (
        <li class="panel spotlight relative flex flex-col gap-3 p-5">
          <span class="font-mono text-xs text-brand-800 dark:text-brand-400">Step {index + 1}</span>
          <a
            href={toolPath(manifest)}
            class="text-lg font-semibold tracking-tight after:absolute after:inset-0 hover:text-brand-800 dark:hover:text-brand-300"
          >
            {manifest.name}
          </a>
          <span class="line-clamp-2 text-sm text-stone-700 dark:text-stone-400">
            {manifest.tagline}
          </span>
          {index < pdfFlow.length - 1 ? (
            <span
              aria-hidden="true"
              class="absolute top-1/2 -right-2.5 z-10 hidden size-5 -translate-y-1/2 items-center justify-center rounded-full border border-stone-200 bg-cream text-xs text-stone-600 lg:flex dark:border-stone-700 dark:bg-stone-950 dark:text-stone-400"
            >
              →
            </span>
          ) : null}
        </li>
      ))}
    </ol>
  </section>

  <!-- Privacy: an architecture claim, with a way to verify it. -->
  <section
    data-reveal
    aria-labelledby="privacy-heading"
    class="panel mt-28 grid gap-10 overflow-hidden p-6 sm:p-10 lg:grid-cols-[1.2fr_1fr]"
  >
    <div>
      <p class="eyebrow">Private by design</p>
      <h2 id="privacy-heading" class="section-title mt-3">
        Your Aadhaar scan never leaves your phone.
      </h2>
      <p class="mt-4 max-w-xl text-stone-700 dark:text-stone-300">
        Most online tools upload your documents to their servers. NiftyFix does the work inside your
        browser, in a sandbox that is not allowed to send anything anywhere.
      </p>
      <a
        href="/privacy-verification/"
        class="mt-6 inline-flex items-center gap-1 font-medium text-brand-800 hover:underline dark:text-brand-300"
      >
        Verify it yourself in two minutes →
      </a>
    </div>
    <pre
      class="self-center overflow-x-auto rounded-xl border border-stone-200 bg-cream p-4 font-mono text-xs leading-relaxed text-stone-700 dark:border-stone-800 dark:bg-stone-950 dark:text-stone-300"
      aria-label="The tool sandbox's network policy"
    >Content-Security-Policy:
  connect-src <span class="text-brand-800 dark:text-brand-300">'self'</span>
  form-action <span class="text-brand-800 dark:text-brand-300">'none'</span>
  frame-src   <span class="text-brand-800 dark:text-brand-300">'none'</span>

<span class="text-emerald-800 dark:text-emerald-400"># files: read in the browser, never sent</span></pre>
  </section>

  <!-- Long tail: every intent page, as plain links. -->
  <section data-reveal aria-labelledby="searches-heading" class="mt-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Popular searches</p>
        <h2 id="searches-heading" class="section-title mt-3">
          Already set up for you. <span class="quiet">Open with the size filled in.</span>
        </h2>
      </div>
      <a
        href="/tools/"
        class="text-sm font-medium text-brand-800 hover:underline dark:text-brand-300"
      >
        Browse all tools →
      </a>
    </div>
    <ul class="mt-8 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3" role="list" data-stagger>
      {intents.map(({ href, h1, tool }) => (
        <li>
          <a
            href={href}
            class="group flex items-baseline justify-between gap-3 border-b border-stone-200 py-3 dark:border-stone-800"
          >
            <span class="group-hover:text-brand-800 dark:group-hover:text-brand-300">{h1}</span>
            <span class="shrink-0 font-mono text-xs text-stone-600 dark:text-stone-400">
              {tool.name}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
