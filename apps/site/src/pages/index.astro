---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { absoluteUrl, registry, SITE_NAME } from '../data/registry';
import { categoryPath } from '@niftyfix/registry';
import { CATEGORIES } from '@niftyfix/tool-sdk';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/') },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: absoluteUrl('/'),
  },
];
---

<Base
  title="NiftyFix — get your files ready for any upload"
  description="Free tools that prepare photos, signatures, documents and media to meet exact upload requirements, then verify the result. Files are processed on your device."
  path="/"
  jsonLd={jsonLd}
>
  <section class="py-6 sm:py-10">
    <h1 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
      Get your files ready. Meet the requirements. Get it done.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-700 dark:text-stone-300">
      Tools that produce the exact file you need — right dimensions, right size, right format — and
      show you proof that it does. Your files stay on your device.
    </p>
    <form role="search" class="mt-8 max-w-xl" action="/" data-tool-search>
      <label for="tool-search" class="mb-2 block text-sm font-medium">
        What do you need to do?
      </label>
      <input
        id="tool-search"
        type="search"
        name="q"
        autocomplete="off"
        placeholder="e.g. resize photo for exam form"
        class="min-h-12 w-full rounded-[var(--radius-control)] border border-stone-300 bg-white px-4 text-base dark:border-stone-700 dark:bg-stone-900"
      />
    </form>
  </section>

  {registry.activeCategories().map((category) => (
    <section class="mt-8" data-category-section>
      <div class="mb-3 flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">{CATEGORIES[category].h1}</h2>
        <a
          href={categoryPath(category)}
          class="text-sm font-medium text-teal-800 hover:underline dark:text-teal-300"
        >
          All {CATEGORIES[category].name.toLowerCase()} tools
        </a>
      </div>
      <p class="mb-4 max-w-[72ch] text-sm text-stone-600 dark:text-stone-400">
        {CATEGORIES[category].description}
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {registry.inCategory(category).map((tool) => (
          <ToolCard manifest={tool.manifest} />
        ))}
      </div>
    </section>
  ))}
  <p class="mt-8 hidden text-stone-600" data-no-results>
    No tool matches that yet. Try different words, such as “photo size” or “KB”.
  </p>
</Base>

<script>
  // Progressive enhancement: filter the statically rendered tool list as the user types.
  const form = document.querySelector<HTMLFormElement>('[data-tool-search]');
  const input = form?.querySelector<HTMLInputElement>('input[type="search"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const empty = document.querySelector<HTMLElement>('[data-no-results]');

  const filter = (): void => {
    const words = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const match = words.every((word) => (card.dataset.terms ?? '').includes(word));
      card.hidden = !match;
      if (match) shown += 1;
    }
    for (const section of document.querySelectorAll<HTMLElement>('[data-category-section]')) {
      section.hidden = section.querySelectorAll('[data-tool-card]:not([hidden])').length === 0;
    }
    empty?.classList.toggle('hidden', shown > 0);
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const first = cards.find((card) => !card.hidden);
    if (first instanceof HTMLAnchorElement) first.click();
  });
  input?.addEventListener('input', filter);
  if (input && new URLSearchParams(location.search).has('q')) {
    input.value = new URLSearchParams(location.search).get('q') ?? '';
    filter();
  }
</script>
