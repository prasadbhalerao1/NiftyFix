---
import Prose from '../layouts/Prose.astro';

/** Third-party code shipped to browsers. Keep in sync with the licence allowlist check. */
const shipped = [
  { name: 'Preact', license: 'MIT', url: 'https://github.com/preactjs/preact' },
  { name: 'Valibot', license: 'MIT', url: 'https://github.com/fabian-hiller/valibot' },
];
/** Fonts served from our own site, all under the SIL Open Font License 1.1. */
const fonts = [
  {
    name: 'Geist',
    license: 'SIL OFL 1.1',
    url: 'https://github.com/vercel/geist-font',
  },
  {
    name: 'Instrument Serif (letters subset)',
    license: 'SIL OFL 1.1',
    url: 'https://github.com/Instrument/instrument-serif',
  },
];
const buildTools = [
  { name: 'Astro', license: 'MIT', url: 'https://github.com/withastro/astro' },
  { name: 'Vite', license: 'MIT', url: 'https://github.com/vitejs/vite' },
  { name: 'Tailwind CSS', license: 'MIT', url: 'https://github.com/tailwindlabs/tailwindcss' },
];
---

<Prose
  title="Third-party licences"
  description="The open-source software and fonts NiftyFix is built with, and the licences under which we use them."
  path="/licenses/"
>
  <p>NiftyFix is built with open-source software. We are grateful to its authors.</p>
  <h2>Code that runs in your browser</h2>
  <ul>
    {shipped.map((item) => (
      <li>
        <a href={item.url}>{item.name}</a>: {item.license}
      </li>
    ))}
  </ul>
  <h2>Fonts</h2>
  <ul>
    {fonts.map((item) => (
      <li>
        <a href={item.url}>{item.name}</a>: {item.license}
      </li>
    ))}
  </ul>
  <h2>Build tools (not shipped to your browser)</h2>
  <ul>
    {buildTools.map((item) => (
      <li>
        <a href={item.url}>{item.name}</a>: {item.license}
      </li>
    ))}
  </ul>
</Prose>
