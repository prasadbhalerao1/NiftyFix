{
  "name": "niftyfix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@niftyfix/site --filter=@niftyfix/tool-frame",
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry": "tsx scripts/generate-registry.ts",
    "check:tools": "tsx scripts/check-tools.ts",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages tools",
    "new-tool": "tsx scripts/new-tool.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "e2e": "playwright test",
    "ci": "pnpm format:check && pnpm lint && pnpm check:tools && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm check:budgets && pnpm e2e"
  },
  "devDependencies": {
    "@niftyfix/portal-specs": "workspace:*",
    "@niftyfix/registry": "workspace:*",
    "@niftyfix/tool-sdk": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
